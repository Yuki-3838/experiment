--- a/Assets/BattleTanks/Programs/System/BattleTanksManager.cs
+++ b/Assets/BattleTanks/Programs/System/BattleTanksManager.cs
@@ -1126,6 +1126,17 @@ namespace SXG2025
 
                 if (renderer.TryGetComponent<Collider>(out var col))
                 {
+                    // PhysX convex contacts can crash for an exactly zero scale axis.
+                    // Give degenerate armor a minimal thickness before making its hull.
+                    // Normal parts, weapon parameters and the measured cost are unchanged.
+                    Vector3 partScale = renderer.transform.localScale;
+                    const float minimumArmorScale = 0.001f;
+                    for (int axis = 0; axis < 3; axis++)
+                    {
+                        if (Mathf.Abs(partScale[axis]) < minimumArmorScale)
+                            partScale[axis] = partScale[axis] < 0 ? -minimumArmorScale : minimumArmorScale;
+                    }
+                    renderer.transform.localScale = partScale;
                     Destroy(col);
 
                     var mc = renderer.gameObject.AddComponent<MeshCollider>();
